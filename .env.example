# ==============================================================================
# ClinGene Website - Environment Variables Configuration
# ==============================================================================

# Resend API Key (Create at https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# Recipient for General Inquiries & Genomic Project Specifications
INFO_EMAIL=ishahabdev@gmail.com

# Recipient for Careers, Job Applications & CV Submissions
CAREERS_EMAIL=ishahabdev@gmail.com

# Sender Address
# In development (unverified domain), use Resend's onboarding address:
FROM_EMAIL="ClinGene Website <onboarding@resend.dev>"
# Once your domain 'clingene.co' is verified in Resend, switch to:
# FROM_EMAIL="ClinGene Website <noreply@clingene.co>"

# Cloudflare Turnstile Bot Protection (Optional for local development)
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# Public site key (exposed to client frontend):
VITE_TURNSTILE_SITE_KEY=
# Private secret key (used by serverless api/contact.js):
TURNSTILE_SECRET_KEY=

